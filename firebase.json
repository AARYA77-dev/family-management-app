{
  "hosting": {
    "public": "dist/family-managment-app/browser",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "redirects": [
      {
        "source": "/department/:splat*",
        "destination": "/access-mot-granded",
        "type": 302
      }
    ]
  }
}